{
  "latex-workshop.latex.tools": [
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "%DOC%"
      ]
    },
    {
      "name": "totxt",
      "command": "sh",
      "args": ["parse.sh", "%DOCFILE%.pdf", "%DOCFILE%-parsed.txt"]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "xelatex + txt",
      "tools": ["xelatex", "totxt"]
    }
  ]
}
