// For format details, see https://aka.ms/devcontainer.json
{
  "name": "TeX Live",
  "image": "resume-texlive-dev",
  "initializeCommand": "docker build --platform=linux/amd64 --tag resume-texlive-dev --file .devcontainer/Dockerfile .",
  "runArgs": ["--platform=linux/amd64"],
  "customizations": {
    "vscode": {
      "extensions": ["james-yu.latex-workshop"],
      "settings": {
        "latex-workshop.latex.autoBuild.run": "onSave",
        "latex-workshop.latex.recipe.default": "latexmk (XeLaTeX) + txt"
      }
    }
  }
}
